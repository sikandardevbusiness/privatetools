# ! Keep this private env var not expose it to the browser
SANITY_API_TOKEN="fasfdsf"

# --- FOR SANITY STUDIO (Vite requires this prefix) ---
SANITY_STUDIO_NAME="PrivateTools"
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
