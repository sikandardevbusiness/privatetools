NEXT_PUBLIC_SITE_DESCRIPTION="Free Online Tools. 100% Private and Secure. Convert, compress, and edit files directly in your browser."

# CONTACT DETAILS
NEXT_PUBLIC_CONTACT_EMAIL="support@privatetools.in"

# --- FOR NEXT.JS ---
NEXT_PUBLIC_SANITY_NAME="PrivateTools"
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
